# Copy this file to .env and fill it in. Never commit .env and never share these values.
# Your MongoDB connection string (MongoDB Atlas: Connect > Drivers > copy the string, put your password in).
MONGODB_URI="mongodb+srv://mongo:admin@database.jkjol.mongodb.net/?appName=database";
# A long random secret used to sign login tokens. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Optional
MONGODB_DB=tally
PORT=3000
# Only needed for the Capacitor phone apps or if the web page is hosted on a different address than the server.
# Comma separated, for example: https://localhost,capacitor://localhost
CORS_ORIGIN=
